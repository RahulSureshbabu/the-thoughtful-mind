---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../utils/strings';

const locale = 'pt' as const;
---

<BaseLayout locale={locale} title={t(locale, 'notFound.title')} description={t(locale, 'notFound.body')}>
	<section class="container not-found">
		<h1>{t(locale, 'notFound.title')}</h1>
		<p>{t(locale, 'notFound.body')} <a href={import.meta.env.BASE_URL}>{t(locale, 'notFound.returnHome')}</a>.</p>
	</section>
</BaseLayout>

<style>
	.not-found {
		padding-block: 4rem;
		text-align: center;
	}
</style>

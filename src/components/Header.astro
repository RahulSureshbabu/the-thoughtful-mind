---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config/site';
import { SOURCE_LOCALE, type Locale } from '../utils/posts';
import { t } from '../utils/strings';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === SOURCE_LOCALE ? '' : `/${locale}`;
const home = `${base}${prefix}/`;
const tagsHref = `${base}${prefix}/tags/`;
const aboutHref = `${base}${prefix}/about/`;
---

<header class="site-header">
	<div class="container inner">
		<a class="brand" href={home}>{SITE.title}</a>
		<nav aria-label="Primary">
			<a href={home}>{t(locale, 'nav.home')}</a>
			<a href={tagsHref}>{t(locale, 'nav.tags')}</a>
			<a href={aboutHref}>{t(locale, 'nav.about')}</a>
		</nav>
		<ThemeToggle locale={locale} />
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
	}

	.inner {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding-block: 1.1rem;
		flex-wrap: wrap;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--text);
		text-decoration: none;
		margin-right: auto;
	}

	nav {
		display: flex;
		gap: 1.1rem;
		font-size: 0.95rem;
	}

	nav a {
		color: var(--text-muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--primary);
	}
</style>

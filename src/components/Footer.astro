---
import { SITE, ADSENSE } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<p>© {year} {SITE.title}</p>
		<div class="links">
			<a href={`${base}/rss.xml`}>RSS</a>
			{ADSENSE.enabled && <span class="ad-disclosure">This site runs ads to help keep it free.</span>}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		margin-top: 3rem;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-block: 1.5rem;
	}

	.links {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, ADSENSE } from '../config/site';
import type { Locale } from '../utils/posts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} title="About" description={`About ${SITE.title}`}>
	<article class="container prose about">
		<h1>About</h1>
		<p>
			{SITE.title} is a home for slow, careful writing about psychology — how the mind works, why we feel
			what we feel, and what the research actually says once the headlines are stripped away.
		</p>
		<p>Posts are written in English and translated automatically for readers around the world.</p>
		{ADSENSE.enabled && <p class="disclosure">This site runs display ads to help cover the cost of keeping it online and ad-free of subscriptions.</p>}
	</article>
</BaseLayout>

<style>
	.about {
		padding-block: 2.5rem 3rem;
	}

	.disclosure {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>

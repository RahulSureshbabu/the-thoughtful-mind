---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ADSENSE } from '../config/site';
import type { Locale } from '../utils/posts';
import { t } from '../utils/strings';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'about.title');
---

<BaseLayout locale={locale} title={title} description={t(locale, 'about.body1')}>
	<article class="container prose about">
		<h1>{title}</h1>
		<p>{t(locale, 'about.body1')}</p>
		<p>{t(locale, 'about.body2')}</p>
		{ADSENSE.enabled && <p class="disclosure">{t(locale, 'footer.adDisclosure')}</p>}
	</article>
</BaseLayout>

<style>
	.about {
		padding-block: 2.5rem 3rem;
	}

	.disclosure {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>

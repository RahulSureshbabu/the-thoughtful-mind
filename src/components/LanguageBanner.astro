---
import { LOCALES, LOCALE_LABELS, type Locale } from '../utils/posts';

interface Props {
	locale: Locale;
	availableLocales?: Locale[];
}

const { locale, availableLocales = LOCALES as unknown as Locale[] } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div
	id="language-banner"
	class="language-banner"
	hidden
	data-current-locale={locale}
	data-available-locales={availableLocales.join(',')}
	data-base={base}
	data-labels={JSON.stringify(LOCALE_LABELS)}
>
	<p class="container">
		<span id="language-banner-text"></span>
		<a id="language-banner-link" href="#">Switch</a>
		<button id="language-banner-dismiss" type="button" aria-label="Dismiss">×</button>
	</p>
</div>

<style>
	.language-banner {
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}

	.language-banner p {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.6rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.language-banner a {
		font-weight: 600;
	}

	#language-banner-dismiss {
		margin-left: auto;
		background: none;
		border: none;
		color: var(--text-muted);
		cursor: pointer;
		font-size: 1.1rem;
		line-height: 1;
		padding: 0.25rem;
	}
</style>

<script>
	const STORAGE_KEY = 'lang-banner-dismissed';
	const banner = document.getElementById('language-banner');
	if (banner && !localStorage.getItem(STORAGE_KEY)) {
		try {
			const currentLocale = banner.dataset.currentLocale!;
			const available = (banner.dataset.availableLocales ?? '').split(',').filter(Boolean);
			const base = banner.dataset.base ?? '/';
			const labels = JSON.parse(banner.dataset.labels ?? '{}') as Record<string, string>;

			const browserLangs = navigator.languages ?? [navigator.language];
			const best = browserLangs
				.map((l) => l.slice(0, 2).toLowerCase())
				.find((short) => available.includes(short) && short !== currentLocale);

			if (best) {
				const path = location.pathname;
				let rest = path.startsWith(base) ? path.slice(base.length) : path;
				rest = '/' + rest.replace(/^\/+/, '');
				const segments = rest.split('/').filter(Boolean);
				if (segments.length > 0 && available.includes(segments[0])) segments.shift();
				const localePrefix = best === 'en' ? '' : `/${best}`;
				const target = `${base}${localePrefix}/${segments.join('/')}`.replace(/\/+$/, '') || `${base}${localePrefix}` || '/';

				const link = document.getElementById('language-banner-link') as HTMLAnchorElement;
				const text = document.getElementById('language-banner-text');
				link.href = target;
				if (text) text.textContent = `This post is also available in ${labels[best] ?? best}.`;
				banner.hidden = false;
			}
		} catch {
			// localStorage/navigator unavailable — silently skip the banner
		}
	}

	document.getElementById('language-banner-dismiss')?.addEventListener('click', () => {
		try {
			localStorage.setItem(STORAGE_KEY, '1');
		} catch {
			// ignore
		}
		if (banner) banner.hidden = true;
	});
</script>

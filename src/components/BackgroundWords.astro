---
import { BACKGROUND_WORDS } from '../utils/backgroundWords';
import type { Locale } from '../utils/posts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
// Non-breaking spaces keep multi-word terms ("Cognitive dissonance") on one line.
const words = BACKGROUND_WORDS[locale].map((w) => w.replace(/ /g, '\u00a0')).join('|');
---

<!-- The words are painted via CSS `content` (not DOM text) so they stay out of find-in-page, text selection and search indexing. -->
<div class="bg-words" aria-hidden="true" data-words={words}></div>

<style>
	.bg-words {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		--mx: -9999px;
		--my: -9999px;
		--reveal: 230px;
		--tracking: 0.14em;
	}

	:global(html[lang='ar']) .bg-words,
	:global(html[lang='hi']) .bg-words {
		/* Letter-spacing breaks cursive joining (Arabic) and conjuncts (Devanagari). */
		--tracking: 0;
	}

	.bg-words::before,
	.bg-words::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		padding: 1rem;
		box-sizing: border-box;
		font-family: inherit;
		font-size: clamp(0.85rem, 0.55rem + 0.45vw, 1.25rem);
		font-weight: 500;
		line-height: 1.9;
		letter-spacing: var(--tracking);
		text-transform: uppercase;
		user-select: none;
		background: linear-gradient(115deg, var(--primary) 0%, var(--accent) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	/* Ambient texture: barely there until the cursor arrives. */
	.bg-words::before {
		opacity: 0.035;
	}

	/* Spotlight: the same words, brighter, revealed around the cursor. */
	.bg-words::after {
		opacity: 0;
		transition: opacity 0.45s ease;
		will-change: transform;
		-webkit-mask-image: radial-gradient(
			circle var(--reveal) at var(--mx) var(--my),
			#000 0%,
			rgba(0, 0, 0, 0.6) 45%,
			transparent 100%
		);
		mask-image: radial-gradient(circle var(--reveal) at var(--mx) var(--my), #000 0%, rgba(0, 0, 0, 0.6) 45%, transparent 100%);
	}

	.bg-words.is-active::after {
		opacity: 0.3;
	}

	@media (prefers-reduced-motion: reduce) {
		.bg-words::after {
			transition: none;
		}
	}

	/* No hover on touch devices, so there is nothing to reveal. */
	@media (hover: none), (pointer: coarse) {
		.bg-words {
			display: none;
		}
	}

	@media print {
		.bg-words {
			display: none;
		}
	}
</style>

<script>
	const layer = document.querySelector<HTMLElement>('.bg-words');
	const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	if (layer && hasFinePointer) {
		const words = (layer.dataset.words ?? '').split('|').filter(Boolean);
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Deterministic shuffle so every build/page renders the same field.
		function mulberry32(seed: number) {
			let a = seed;
			return () => {
				a = (a + 0x6d2b79f5) | 0;
				let t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		}

		function buildField(count: number): string {
			const out: string[] = [];
			for (let rep = 1; out.length < count; rep++) {
				const rand = mulberry32(rep);
				const pool = [...words];
				for (let i = pool.length - 1; i > 0; i--) {
					const j = Math.floor(rand() * (i + 1));
					[pool[i], pool[j]] = [pool[j], pool[i]];
				}
				out.push(...pool);
			}
			// Em space keeps entries visually separate without word-spacing side effects.
			return out.slice(0, count).join('\u2003');
		}

		let built = 0;
		function fillViewport() {
			if (!words.length) return;
			const fontSize = parseFloat(getComputedStyle(layer!, '::before').fontSize) || 16;
			const needed = Math.min(2000, Math.ceil((window.innerWidth * window.innerHeight) / (fontSize * fontSize * 13)));
			if (needed > built) {
				layer!.setAttribute('data-text', buildField(needed));
				built = needed;
			}
		}

		fillViewport();
		let resizeTimer = 0;
		window.addEventListener('resize', () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(fillViewport, 150);
		});

		let targetX = 0;
		let targetY = 0;
		let x = 0;
		let y = 0;
		let seen = false;
		let frame = 0;

		const paint = () => {
			layer.style.setProperty('--mx', `${x}px`);
			layer.style.setProperty('--my', `${y}px`);
		};

		const follow = () => {
			x += (targetX - x) * 0.22;
			y += (targetY - y) * 0.22;
			paint();
			frame = Math.abs(targetX - x) > 0.4 || Math.abs(targetY - y) > 0.4 ? requestAnimationFrame(follow) : 0;
		};

		window.addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType === 'touch') return;
				targetX = event.clientX;
				targetY = event.clientY;
				layer.classList.add('is-active');

				// Snap on first contact (or with reduced motion) instead of sweeping in from off-screen.
				if (!seen || reduceMotion) {
					x = targetX;
					y = targetY;
					seen = true;
					paint();
					return;
				}
				if (!frame) frame = requestAnimationFrame(follow);
			},
			{ passive: true },
		);

		document.documentElement.addEventListener('mouseleave', () => {
			layer.classList.remove('is-active');
			seen = false;
		});
	}
</script>

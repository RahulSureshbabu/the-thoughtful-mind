---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTags, SOURCE_LOCALE, type Locale } from '../utils/posts';
import { t } from '../utils/strings';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const tags = await getAllTags(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === SOURCE_LOCALE ? '' : `/${locale}`;
const title = t(locale, 'nav.tags');
---

<BaseLayout locale={locale} title={title} description={title}>
	<section class="container tags-page">
		<h1>{title}</h1>
		{tags.length === 0 && <p>{t(locale, 'tags.empty')}</p>}
		<p class="tag-list">
			{tags.map((tag) => <a class="tag-chip" href={`${base}${prefix}/tags/${tag}/`}>{tag}</a>)}
		</p>
	</section>
</BaseLayout>

<style>
	.tags-page {
		padding-block: 2.5rem 3rem;
	}

	.tag-list {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
</style>

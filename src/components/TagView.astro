---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { getPostsByTag, type Locale } from '../utils/posts';
import { t } from '../utils/strings';

interface Props {
	locale: Locale;
	tag: string;
}

const { locale, tag } = Astro.props;
const posts = await getPostsByTag(locale, tag);
---

<BaseLayout locale={locale} title={`#${tag}`} description={`#${tag}`}>
	<section class="container tag-page">
		<h1>#{tag}</h1>
		{posts.length === 0 && <p>{t(locale, 'tag.empty')}</p>}
		{posts.map((post) => <PostCard post={post} locale={locale} />)}
	</section>
</BaseLayout>

<style>
	.tag-page {
		padding-block: 2.5rem 3rem;
	}
</style>
